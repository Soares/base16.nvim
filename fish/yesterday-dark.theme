# Yesterday dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal d6d6d6
fish_color_command 8959a8
fish_color_keyword 3e999f
fish_color_quote eab700
fish_color_redirection 4271ae
fish_color_end 8e908c
fish_color_error c82829
fish_color_param f5871f
fish_color_comment 969896
fish_color_selection --reverse
fish_color_operator d6d6d6
fish_color_escape 4271ae
fish_color_autosuggestion 969896
fish_color_cwd f5871f
fish_color_user eab700
fish_color_host 3e999f
fish_color_host_remote 8959a8
fish_color_cancel d6d6d6
fish_color_search_match --background=1d1f21
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress f5871f
fish_pager_color_background --background=282a2e
fish_pager_color_prefix 3e999f
fish_pager_color_completion 8e908c
fish_pager_color_description 8e908c
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=4d4d4c
fish_pager_color_selected_prefix 3e999f
fish_pager_color_selected_completion d6d6d6
fish_pager_color_selected_description d6d6d6
