# shapeshifter dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal ababab
fish_color_command f996e2
fish_color_keyword 23edda
fish_color_quote dddd13
fish_color_redirection 3b48e3
fish_color_end 555555
fish_color_error e92f2f
fish_color_param e09448
fish_color_comment 343434
fish_color_selection --reverse
fish_color_operator ababab
fish_color_escape 3b48e3
fish_color_autosuggestion 343434
fish_color_cwd e09448
fish_color_user dddd13
fish_color_host 23edda
fish_color_host_remote f996e2
fish_color_cancel ababab
fish_color_search_match --background=000000
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress e09448
fish_pager_color_background --background=040404
fish_pager_color_prefix 23edda
fish_pager_color_completion 555555
fish_pager_color_description 555555
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=102015
fish_pager_color_selected_prefix 23edda
fish_pager_color_selected_completion ababab
fish_pager_color_selected_description ababab
