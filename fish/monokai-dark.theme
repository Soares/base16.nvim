# Monokai dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal f8f8f2
fish_color_command ae81ff
fish_color_keyword a1efe4
fish_color_quote f4bf75
fish_color_redirection 66d9ef
fish_color_end a59f85
fish_color_error f92672
fish_color_param fd971f
fish_color_comment 75715e
fish_color_selection --reverse
fish_color_operator f8f8f2
fish_color_escape 66d9ef
fish_color_autosuggestion 75715e
fish_color_cwd fd971f
fish_color_user f4bf75
fish_color_host a1efe4
fish_color_host_remote ae81ff
fish_color_cancel f8f8f2
fish_color_search_match --background=272822
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress fd971f
fish_pager_color_background --background=383830
fish_pager_color_prefix a1efe4
fish_pager_color_completion a59f85
fish_pager_color_description a59f85
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=49483e
fish_pager_color_selected_prefix a1efe4
fish_pager_color_selected_completion f8f8f2
fish_pager_color_selected_description f8f8f2
