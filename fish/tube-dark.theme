# London Tube dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal d9d8d8
fish_color_command 98005d
fish_color_keyword 85cebc
fish_color_quote ffd204
fish_color_redirection 009ddc
fish_color_end 959ca1
fish_color_error ee2e24
fish_color_param f386a1
fish_color_comment 737171
fish_color_selection --reverse
fish_color_operator d9d8d8
fish_color_escape 009ddc
fish_color_autosuggestion 737171
fish_color_cwd f386a1
fish_color_user ffd204
fish_color_host 85cebc
fish_color_host_remote 98005d
fish_color_cancel d9d8d8
fish_color_search_match --background=231f20
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress f386a1
fish_pager_color_background --background=1c3f95
fish_pager_color_prefix 85cebc
fish_pager_color_completion 959ca1
fish_pager_color_description 959ca1
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=5a5758
fish_pager_color_selected_prefix 85cebc
fish_pager_color_selected_completion d9d8d8
fish_pager_color_selected_description d9d8d8
