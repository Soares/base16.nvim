# Brewer dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal b7b8b9
fish_color_command 756bb1
fish_color_keyword 80b1d3
fish_color_quote dca060
fish_color_redirection 3182bd
fish_color_end 959697
fish_color_error e31a1c
fish_color_param e6550d
fish_color_comment 737475
fish_color_selection --reverse
fish_color_operator b7b8b9
fish_color_escape 3182bd
fish_color_autosuggestion 737475
fish_color_cwd e6550d
fish_color_user dca060
fish_color_host 80b1d3
fish_color_host_remote 756bb1
fish_color_cancel b7b8b9
fish_color_search_match --background=0c0d0e
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress e6550d
fish_pager_color_background --background=2e2f30
fish_pager_color_prefix 80b1d3
fish_pager_color_completion 959697
fish_pager_color_description 959697
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=515253
fish_pager_color_selected_prefix 80b1d3
fish_pager_color_selected_completion b7b8b9
fish_pager_color_selected_description b7b8b9
