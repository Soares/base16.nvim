# Atelier Savanna dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 87928a
fish_color_command 55859b
fish_color_keyword 1c9aa0
fish_color_quote a07e3b
fish_color_redirection 478c90
fish_color_end 78877d
fish_color_error b16139
fish_color_param 9f713c
fish_color_comment 5f6d64
fish_color_selection --reverse
fish_color_operator 87928a
fish_color_escape 478c90
fish_color_autosuggestion 5f6d64
fish_color_cwd 9f713c
fish_color_user a07e3b
fish_color_host 1c9aa0
fish_color_host_remote 55859b
fish_color_cancel 87928a
fish_color_search_match --background=171c19
fish_color_valid_path

