fish_color_normal 19171c
fish_color_command 955ae7
fish_color_keyword 398bc6
fish_color_quote a06e3b
fish_color_redirection 576ddb
fish_color_end 7e7887
fish_color_error be4678
fish_color_param aa573c
fish_color_comment 655f6d
fish_color_selection --reverse
fish_color_operator 19171c
fish_color_escape 576ddb
fish_color_autosuggestion 655f6d
fish_color_cwd aa573c
fish_color_user a06e3b
fish_color_host 398bc6
fish_color_host_remote 955ae7
fish_color_cancel 19171c
fish_color_search_match --background=efecf4
fish_color_valid_path

