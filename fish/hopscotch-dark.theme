# Hopscotch dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal b9b5b8
fish_color_command c85e7c
fish_color_keyword 149b93
fish_color_quote fdcc59
fish_color_redirection 1290bf
fish_color_end 989498
fish_color_error dd464c
fish_color_param fd8b19
fish_color_comment 797379
fish_color_selection --reverse
fish_color_operator b9b5b8
fish_color_escape 1290bf
fish_color_autosuggestion 797379
fish_color_cwd fd8b19
fish_color_user fdcc59
fish_color_host 149b93
fish_color_host_remote c85e7c
fish_color_cancel b9b5b8
fish_color_search_match --background=322931
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress fd8b19
fish_pager_color_background --background=433b42
fish_pager_color_prefix 149b93
fish_pager_color_completion 989498
fish_pager_color_description 989498
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=5c545b
fish_pager_color_selected_prefix 149b93
fish_pager_color_selected_completion b9b5b8
fish_pager_color_selected_description b9b5b8
