# Tomorrow light theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 1d1f21
fish_color_command b294bb
fish_color_keyword 8abeb7
fish_color_quote f0c674
fish_color_redirection 81a2be
fish_color_end b4b7b4
fish_color_error cc6666
fish_color_param de935f
fish_color_comment 969896
fish_color_selection --reverse
fish_color_operator 1d1f21
fish_color_escape 81a2be
fish_color_autosuggestion 969896
fish_color_cwd de935f
fish_color_user f0c674
fish_color_host 8abeb7
fish_color_host_remote b294bb
fish_color_cancel 1d1f21
fish_color_search_match --background=ffffff
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress de935f
fish_pager_color_background --background=e0e0e0
fish_pager_color_prefix 8abeb7
fish_pager_color_completion b4b7b4
fish_pager_color_description b4b7b4
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=c5c8c6
fish_pager_color_selected_prefix 8abeb7
fish_pager_color_selected_completion 1d1f21
fish_pager_color_selected_description 1d1f21
