# Tokyo Night light theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 1a1b26
fish_color_command 5a4a78
fish_color_keyword 3e6968
fish_color_quote 166775
fish_color_redirection 34548a
fish_color_end cbccd1
fish_color_error 343b58
fish_color_param 965027
fish_color_comment 9699a3
fish_color_selection --reverse
fish_color_operator 1a1b26
fish_color_escape 34548a
fish_color_autosuggestion 9699a3
fish_color_cwd 965027
fish_color_user 166775
fish_color_host 3e6968
fish_color_host_remote 5a4a78
fish_color_cancel 1a1b26
fish_color_search_match --background=d5d6db
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress 965027
fish_pager_color_background --background=dfe0e5
