# Catppuccin dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal cdd6f4
fish_color_command cba6f7
fish_color_keyword 94e2d5
fish_color_quote f9e2af
fish_color_redirection 89b4fa
fish_color_end 585b70
fish_color_error f38ba8
fish_color_param fab387
fish_color_comment 45475a
fish_color_selection --reverse
fish_color_operator cdd6f4
fish_color_escape 89b4fa
fish_color_autosuggestion 45475a
fish_color_cwd fab387
fish_color_user f9e2af
fish_color_host 94e2d5
fish_color_host_remote cba6f7
fish_color_cancel cdd6f4
fish_color_search_match --background=1e1e2e
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress fab387
fish_pager_color_background --background=181825
fish_pager_color_prefix 94e2d5
fish_pager_color_completion 585b70
fish_pager_color_description 585b70
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=313244
fish_pager_color_selected_prefix 94e2d5
fish_pager_color_selected_completion cdd6f4
fish_pager_color_selected_description cdd6f4
