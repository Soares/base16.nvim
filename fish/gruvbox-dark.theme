# Gruvbox dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal d5c4a1
fish_color_command d3869b
fish_color_keyword 8ec07c
fish_color_quote fabd2f
fish_color_redirection 83a598
fish_color_end bdae93
fish_color_error fb4934
fish_color_param fe8019
fish_color_comment 665c54
fish_color_selection --reverse
fish_color_operator d5c4a1
fish_color_escape 83a598
fish_color_autosuggestion 665c54
fish_color_cwd fe8019
fish_color_user fabd2f
fish_color_host 8ec07c
fish_color_host_remote d3869b
fish_color_cancel d5c4a1
fish_color_search_match --background=282828
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress fe8019
fish_pager_color_background --background=3c3836
fish_pager_color_prefix 8ec07c
fish_pager_color_completion bdae93
fish_pager_color_description bdae93
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=504945
fish_pager_color_selected_prefix 8ec07c
fish_pager_color_selected_completion d5c4a1
fish_pager_color_selected_description d5c4a1
