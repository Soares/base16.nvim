# Greenscreen light theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 001100
fish_color_command 00bb00
fish_color_keyword 005500
fish_color_quote 007700
fish_color_redirection 009900
fish_color_end 009900
fish_color_error 007700
fish_color_param 009900
fish_color_comment 007700
fish_color_selection --reverse
fish_color_operator 001100
fish_color_escape 009900
fish_color_autosuggestion 007700
fish_color_cwd 009900
fish_color_user 007700
fish_color_host 005500
fish_color_host_remote 00bb00
fish_color_cancel 001100
fish_color_search_match --background=00ff00
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress 009900
fish_pager_color_background --background=00dd00
fish_pager_color_prefix 005500
fish_pager_color_completion 009900
fish_pager_color_description 009900
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=00bb00
fish_pager_color_selected_prefix 005500
fish_pager_color_selected_completion 001100
fish_pager_color_selected_description 001100
