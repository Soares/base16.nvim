# Isotope dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal d0d0d0
fish_color_command cc00ff
fish_color_keyword 00ffff
fish_color_quote ff0099
fish_color_redirection 0066ff
fish_color_end c0c0c0
fish_color_error ff0000
fish_color_param ff9900
fish_color_comment 808080
fish_color_selection --reverse
fish_color_operator d0d0d0
fish_color_escape 0066ff
fish_color_autosuggestion 808080
fish_color_cwd ff9900
fish_color_user ff0099
fish_color_host 00ffff
fish_color_host_remote cc00ff
fish_color_cancel d0d0d0
fish_color_search_match --background=000000
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress ff9900
fish_pager_color_background --background=404040
fish_pager_color_prefix 00ffff
fish_pager_color_completion c0c0c0
fish_pager_color_description c0c0c0
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=606060
fish_pager_color_selected_prefix 00ffff
fish_pager_color_selected_completion d0d0d0
fish_pager_color_selected_description d0d0d0
