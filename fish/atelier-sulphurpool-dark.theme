# Atelier Sulphurpool dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 979db4
fish_color_command 6679cc
fish_color_keyword 22a2c9
fish_color_quote c08b30
fish_color_redirection 3d8fd1
fish_color_end 898ea4
fish_color_error c94922
fish_color_param c76b29
fish_color_comment 6b7394
fish_color_selection --reverse
fish_color_operator 979db4
fish_color_escape 3d8fd1
fish_color_autosuggestion 6b7394
fish_color_cwd c76b29
fish_color_user c08b30
fish_color_host 22a2c9
fish_color_host_remote 6679cc
fish_color_cancel 979db4
fish_color_search_match --background=202746
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress c76b29
fish_pager_color_background --background=293256
fish_pager_color_prefix 22a2c9
fish_pager_color_completion 898ea4
fish_pager_color_description 898ea4
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=5e6687
fish_pager_color_selected_prefix 22a2c9
fish_pager_color_selected_completion 979db4
fish_pager_color_selected_description 979db4
