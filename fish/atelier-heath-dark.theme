# Atelier Heath dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal ab9bab
fish_color_command 7b59c0
fish_color_keyword 159393
fish_color_quote bb8a35
fish_color_redirection 516aec
fish_color_end 9e8f9e
fish_color_error ca402b
fish_color_param a65926
fish_color_comment 776977
fish_color_selection --reverse
fish_color_operator ab9bab
fish_color_escape 516aec
fish_color_autosuggestion 776977
fish_color_cwd a65926
fish_color_user bb8a35
fish_color_host 159393
fish_color_host_remote 7b59c0
fish_color_cancel ab9bab
fish_color_search_match --background=1b181b
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress a65926
fish_pager_color_background --background=292329
fish_pager_color_prefix 159393
fish_pager_color_completion 9e8f9e
fish_pager_color_description 9e8f9e
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=695d69
fish_pager_color_selected_prefix 159393
fish_pager_color_selected_completion ab9bab
fish_pager_color_selected_description ab9bab
