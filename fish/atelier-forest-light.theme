# Atelier Forest light theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 1b1918
fish_color_command 6666ea
fish_color_keyword 3d97b8
fish_color_quote c38418
fish_color_redirection 407ee7
fish_color_end 9c9491
fish_color_error f22c40
fish_color_param df5320
fish_color_comment 766e6b
fish_color_selection --reverse
fish_color_operator 1b1918
fish_color_escape 407ee7
fish_color_autosuggestion 766e6b
fish_color_cwd df5320
fish_color_user c38418
fish_color_host 3d97b8
fish_color_host_remote 6666ea
fish_color_cancel 1b1918
fish_color_search_match --background=f1efee
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress df5320
fish_pager_color_background --background=e6e2e0
fish_pager_color_prefix 3d97b8
fish_pager_color_completion 9c9491
fish_pager_color_description 9c9491
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=a8a19f
fish_pager_color_selected_prefix 3d97b8
fish_pager_color_selected_completion 1b1918
fish_pager_color_selected_description 1b1918
