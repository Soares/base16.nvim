# Apathy dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 81B5AC
fish_color_command 4C963E
fish_color_keyword 963E4C
fish_color_quote 3E4C96
fish_color_redirection 96883E
fish_color_end 5F9C92
fish_color_error 3E9688
fish_color_param 3E7996
fish_color_comment 2B685E
fish_color_selection --reverse
fish_color_operator 81B5AC
fish_color_escape 96883E
fish_color_autosuggestion 2B685E
fish_color_cwd 3E7996
fish_color_user 3E4C96
fish_color_host 963E4C
fish_color_host_remote 4C963E
fish_color_cancel 81B5AC
fish_color_search_match --background=031A16
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress 3E7996
fish_pager_color_background --background=0B342D
fish_pager_color_prefix 963E4C
fish_pager_color_completion 5F9C92
fish_pager_color_description 5F9C92
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=184E45
fish_pager_color_selected_prefix 963E4C
fish_pager_color_selected_completion 81B5AC
fish_pager_color_selected_description 81B5AC
