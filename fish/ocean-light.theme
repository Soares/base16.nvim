# Ocean light theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 2b303b
fish_color_command b48ead
fish_color_keyword 96b5b4
fish_color_quote ebcb8b
fish_color_redirection 8fa1b3
fish_color_end a7adba
fish_color_error bf616a
fish_color_param d08770
fish_color_comment 65737e
fish_color_selection --reverse
fish_color_operator 2b303b
fish_color_escape 8fa1b3
fish_color_autosuggestion 65737e
fish_color_cwd d08770
fish_color_user ebcb8b
fish_color_host 96b5b4
fish_color_host_remote b48ead
fish_color_cancel 2b303b
fish_color_search_match --background=eff1f5
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress d08770
fish_pager_color_background --background=dfe1e8
fish_pager_color_prefix 96b5b4
fish_pager_color_completion a7adba
fish_pager_color_description a7adba
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=c0c5ce
fish_pager_color_selected_prefix 96b5b4
fish_pager_color_selected_completion 2b303b
fish_pager_color_selected_description 2b303b
