# Atelier Dune light theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 20201d
fish_color_command b854d4
fish_color_keyword 1fad83
fish_color_quote ae9513
fish_color_redirection 6684e1
fish_color_end 999580
fish_color_error d73737
fish_color_param b65611
fish_color_comment 7d7a68
fish_color_selection --reverse
fish_color_operator 20201d
fish_color_escape 6684e1
fish_color_autosuggestion 7d7a68
fish_color_cwd b65611
fish_color_user ae9513
fish_color_host 1fad83
fish_color_host_remote b854d4
fish_color_cancel 20201d
fish_color_search_match --background=fefbec
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress b65611
fish_pager_color_background --background=e8e4cf
fish_pager_color_prefix 1fad83
fish_pager_color_completion 999580
fish_pager_color_description 999580
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=a6a28c
fish_pager_color_selected_prefix 1fad83
fish_pager_color_selected_completion 20201d
fish_pager_color_selected_description 20201d
