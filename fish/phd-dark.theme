# PhD dark theme
# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal b8bbc2
fish_color_command 9989cc
fish_color_keyword 72b9bf
fish_color_quote fbd461
fish_color_redirection 5299bf
fish_color_end 9a99a3
fish_color_error d07346
fish_color_param f0a000
fish_color_comment 717885
fish_color_selection --reverse
fish_color_operator b8bbc2
fish_color_escape 5299bf
fish_color_autosuggestion 717885
fish_color_cwd f0a000
fish_color_user fbd461
fish_color_host 72b9bf
fish_color_host_remote 9989cc
fish_color_cancel b8bbc2
fish_color_search_match --background=061229
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress f0a000
fish_pager_color_background --background=2a3448
fish_pager_color_prefix 72b9bf
fish_pager_color_completion 9a99a3
fish_pager_color_description 9a99a3
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=4d5666
fish_pager_color_selected_prefix 72b9bf
fish_pager_color_selected_completion b8bbc2
fish_pager_color_selected_description b8bbc2
